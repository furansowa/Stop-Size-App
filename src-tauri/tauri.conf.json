{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StopSizeWidget",
  "version": "0.2.0",
  "identifier": "com.stopsizewidget.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stop Size Widget",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 336,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
